# Copy this file to ".env" and fill in real values. Never commit .env.
# In production, add the same names as Railway "Variables".

# --- Claude (console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=your-key-here
# Only needed if your key is not scoped to a workspace (Console -> Workspaces -> the id starting with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Your own WhatsApp number (the reviewer). Digits only, with country code, no + ---
OWNER_PHONE=16045551234

# --- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings -> Basic -> App secret
WHATSAPP_APP_SECRET=
# Any random string you invent; you type the same string into Meta's webhook form
WHATSAPP_VERIFY_TOKEN=
# Template used when you approve more than 24h after the customer's message
WHATSAPP_CONFIRM_TEMPLATE=order_confirmed
WHATSAPP_CONFIRM_TEMPLATE_LANG=en

# --- Supabase (Project settings -> API). Use the service_role key, not the anon key ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Google Sheets ---
# The whole service-account JSON file pasted on ONE line
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Orders
